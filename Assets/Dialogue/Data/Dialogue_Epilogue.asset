  m_Script: {fileID: 11500000, guid: 3b101ddc51b680541b32164e5d3bfef1, type: 3}
  m_Name: Dialogue_Epilogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  location: THE RIDGE - SUNRISE
  background: {fileID: 0}
  lines:
  - speakerId: TALA
    emotion: 5
    text: There. Look.
    side: 0
    radio: 0
  - speakerId: ROOK
    emotion: 5
    text: Is that...
    side: 0
    radio: 0
  - speakerId: TALA
    emotion: 5
    text: Sultan.
    side: 0
    radio: 0
  - speakerId: SULTAN
    emotion: 1
    text: '{sfx=roar}'
    side: 0
    radio: 0
  - speakerId: PIP
    emotion: 5
    text: All my patients. All of them. Oh, I'm going to cry on a radio.
    side: 0
    radio: 1
  - speakerId: ROOK
    emotion: 0
    text: It's just the wind.
    side: 0
    radio: 0
  - speakerId: PIP
    emotion: 0
    text: You said you weren't a cat person.
    side: 0
    radio: 1
  - speakerId: ROOK
    emotion: 0
    text: I'm not.
    side: 0
    radio: 0
  - speakerId: TALA
    emotion: 2
    text: You're crying, Rook.
    side: 0
    radio: 0
  - speakerId: ROOK
    emotion: 0
    text: ...It's the wind.
    side: 0
    radio: 0
  - speakerId: DOBBS
    emotion: 0
    text: Excuse me, do I still, uh, have to feed them?
    side: 0
    radio: 0
  - speakerId: TALA
    emotion: 0
    text: Yes. Forever.
    side: 0
    radio: 0
