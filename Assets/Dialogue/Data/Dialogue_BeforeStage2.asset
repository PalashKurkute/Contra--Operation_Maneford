  m_Script: {fileID: 11500000, guid: 3b101ddc51b680541b32164e5d3bfef1, type: 3}
  m_Name: Dialogue_BeforeStage2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  location: THE KING'S BASE - MAIN GATE
  background: {fileID: 0}
  lines:
  - speakerId: ROOK
    emotion: 0
    text: That's a big banner.
    side: 0
    radio: 0
  - speakerId: PIP
    emotion: 3
    text: That's... his face. With a lion mane. On a helmet. He made a helmet. I'm
      filing this under 'concerning.'
    side: 0
    radio: 1
  - speakerId: ROOK
    emotion: 0
    text: Who is he?
    side: 0
    radio: 0
  - speakerId: PIP
    emotion: 0
    text: General Leopold Maneford. Decorated. Retired. Apparently unretired. He
      used to run this reserve as a hobby.
    side: 0
    radio: 1
  - speakerId: ROOK
    emotion: 0
    text: Hobby?
    side: 0
    radio: 0
  - speakerId: PIP
    emotion: 5
    text: He liked lions. Looks like the lions did not like him back.
    side: 0
    radio: 1
  nextSceneName: 
