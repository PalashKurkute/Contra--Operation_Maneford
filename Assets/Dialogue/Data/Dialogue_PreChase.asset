  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b101ddc51b680541b32164e5d3bfef1, type: 3}
  m_Name: Dialogue_PreChase
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  location: STOLEN HELICOPTER - NIGHT
  background: {fileID: 0}
  lines:
  - speakerId: TALA
    emotion: 0
    text: I can fly planes. This is a helicopter. These are different things.
    side: 0
    radio: 0
  - speakerId: ROOK
    emotion: 0
    text: I'll fly.
    side: 0
    radio: 0
  - speakerId: TALA
    emotion: 3
    text: Can you?
    side: 0
    radio: 0
  - speakerId: ROOK
    emotion: 0
    text: No.
    side: 0
    radio: 0
  - speakerId: TALA
    emotion: 0
    text: ...Great.
    side: 0
    radio: 0
  - speakerId: DOBBS
    emotion: 4
    text: Uh, hi! It's Dobbs! I'm in custody but they let me use the radio! The General's
      helicopter, the fuel gauge is broken! It's been on empty since Tuesday! Nobody
      told him!
    side: 0
    radio: 1
  - speakerId: PIP
    emotion: 3
    text: So if you can just keep him busy...
    side: 0
    radio: 1
  - speakerId: ROOK
    emotion: 0
    text: ...he runs out of gas.
    side: 0
    radio: 0
  - speakerId: TALA
    emotion: 5
    text: Then let's keep him busy.
    side: 0
    radio: 0
  nextSceneName: 
