  subtitles:
  - start: 2
    end: 5.95
    speaker: PIP
    speakerColor: {r: 0.35, g: 0.9, b: 1, a: 1}
    text: Day nine. The Maneford Reserve stopped answering our calls.
  - start: 6.3
    end: 7.45
    speaker: PIP
    speakerColor: {r: 0.35, g: 0.9, b: 1, a: 1}
    text: We sent drones.
  - start: 10
    end: 12.3
    speaker: PIP
    speakerColor: {r: 0.35, g: 0.9, b: 1, a: 1}
    text: They came back with... questions.
  - start: 15.9
    end: 17.6
    speaker: PIP
    speakerColor: {r: 0.35, g: 0.9, b: 1, a: 1}
    text: So now we're sending Rook.
  placeholderImage: {fileID: 0}
  placeholderText: 'Aerial shot of the forest at dusk, quiet. A distant roar. A chained
